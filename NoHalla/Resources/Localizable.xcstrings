    },
    "apps.scope-agent-terminals-help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the app running. Stops AI agent sessions started in its terminals — Claude Code, Codex, Antigravity, Gemini, Grok, Copilot, Cursor and similar — with their tool calls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение продолжает работать. Останавливаются только сессии AI-агентов, запущенные в его терминалах, — Claude Code, Codex, Antigravity, Gemini, Grok, Copilot, Cursor и подобные — вместе с вызовами инструментов."
          }
        }
      }
    },
