    "caption.resumeBypass": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps will unfreeze for %d minutes, then protection resumes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения возобновятся на %d минут, затем защита включится снова."
          }
        }
      }
    },
    "empty.noTrusted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trusted realm yet. Protection can't start."
