    "quit.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d frozen apps will be resumed. The gate will open and protection will stop until you launch No-halla again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замороженные приложения (%d) возобновятся. Ворота откроются, а защита остановится до следующего запуска No-halla."
          }
        }
      }
    },
    "quit.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and Resume"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти и возобновить"
          }
