    "notification.frozen.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your IP changed to %@. %@ are waiting at the gate until your VPN returns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш IP изменился на %@. %@ ждут у ворот, пока VPN не вернётся."
          }
        }
      }
    },
    "notification.frozen.reason-changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a new address"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "новый адрес"
          }
        }
      }
    },
    "notification.frozen.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gate is closed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ворота закрыты"
          }
        }
      }
    },
    "notification.resumed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted IP is back. %@ are running again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверенный IP вернулся. %@ снова работают."
          }
        }
      }
    },
    "notification.resumed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gate is open"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ворота открыты"
          }
        }
      }
    },
    "notification.unknown.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No-halla can't reach the IP check services. Protected apps will stay frozen until the check succeeds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "No-halla не может связаться с сервисами проверки IP. Защищённые приложения останутся замороженными, пока проверка не пройдёт."
          }
        }
      }
    },
    "notification.unknown.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gate doesn't answer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ворота не отвечают"
          }
        }
      }
    },
    "onboarding.1.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No-halla watches your IP. If it leaves the trusted realm, selected apps wait at the gate and blocked sites stop resolving until your VPN returns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "No-halla следит за IP. Если он покидает доверенный мир, выбранные приложения ждут у ворот, а заблокированные домены перестают открываться, пока VPN не вернётся."
          }
        }
      }
    },
    "onboarding.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the gate closed when the VPN falls"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывайте ворота, когда падает VPN"
          }
        }
      }
    },
    "onboarding.2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose who waits at the gate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, кто будет ждать у ворот"
          }
        }
      }
    },
    "onboarding.3.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how trust is decided. In IP mode, add the address your VPN exposes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как определяется доверие. В режиме IP добавьте адрес, который выдаёт ваш VPN."
          }
        }
      }
    },
    "onboarding.3.need-ip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one trusted IP to continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте хотя бы один доверенный IP, чтобы продолжить."
          }
        }
      }
    },
    "onboarding.3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust your VPN's realm"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверьтесь миру вашего VPN"
          }
        }
      }
    },
    "onboarding.4.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: these domains and all their subdomains will not resolve while the IP is not trusted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: эти домены и все их поддомены не будут открываться, пока IP недоверенный."
          }
        }
      }
    },
    "onboarding.4.helper": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared packages can be imported later in Settings → Protection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общие пакеты можно импортировать позже в Settings → Protection."
          }
        }
      }
    },
    "onboarding.4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked sites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокированные сайты"
          }
        }
      }
    },
