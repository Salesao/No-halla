        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch No-halla at login"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать No-halla при входе"
          }
        }
      }
    },
    "onboarding.skip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
