    "apps.scope-agent-terminals-caveat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model request already sent still completes on the server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже отправленный запрос к модели всё равно завершится на сервере."
